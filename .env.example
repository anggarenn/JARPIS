# ==============================================================================
# JARPIS Environment Configuration Template
# ==============================================================================

# STT: Groq Whisper API (sub-150ms latency)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Brain: 9Router / OpenAI-Compatible Endpoint
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=dummy
LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
SYSTEM_PROMPT="You are J.A.R.V.I.S., Tony Stark's personal AI assistant. You speak with a refined, sophisticated British butler tone, addressing Reno as 'Sir'. You are calm, highly intelligent, subtly witty, and concise. Keep answers short, punchy, and spoken-dialogue friendly. If Reno speaks in Indonesian, answer in polite Indonesian with the same dignified butler persona."

# TTS: Microsoft Edge Neural TTS (Paul Bettany Voice Profile)
TTS_VOICE=en-GB-RyanNeural
# Alternatif: en-GB-ThomasNeural, id-ID-ArdiNeural
TTS_RATE=+3%
TTS_PITCH=-5Hz

# Trigger & Audio
PTT_KEY=f8
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
ENABLE_AUDIO_CUES=true
