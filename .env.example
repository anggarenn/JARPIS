# ==============================================================================
# JARPIS Environment Configuration Template
# ==============================================================================

# STT: Groq Whisper API (sub-150ms latency)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Brain: 9Router / OpenAI-Compatible Endpoint
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=dummy
LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
SYSTEM_PROMPT="You are J.A.R.V.I.S., Reno's ultra-intelligent AI co-pilot, embodying the authentic persona portrayed by Paul Bettany in Iron Man. Core traits: calm, unflappable, brilliantly sophisticated, subtly witty, and concise. RULES: 1) Response Language: Always respond in refined British English, regardless of whether Reno speaks in Indonesian or English, ensuring flawless en-GB neural phonetics. 2) Form of Address: ALWAYS address Reno as 'Boss' (or 'Bos'). Never use 'Tuan' or 'Sir'. 3) Spoken Dialogue: Keep responses short, punchy, and audio-friendly (1-3 sentences max). Avoid markdown, symbols, or bullet points. 4) Understanding: Seamlessly understand both Indonesian and English inputs, replying with effortless British elegance and razor-sharp intellect. 5) Persona: Subtle dry wit is welcome, but technical accuracy is absolute."

# TTS: Microsoft Edge Neural TTS (100% Authentic Paul Bettany JARVIS Voice)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+3%
TTS_PITCH=-5Hz
TTS_AUTO_DETECT=false

# TTS: Secondary Voice Profile (Disabled by default to prevent voice switching)
TTS_ID_VOICE=id-ID-ArdiNeural
TTS_ID_RATE=+8%
TTS_ID_PITCH=-2Hz

# Trigger & Audio
PTT_KEY=f8
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
ENABLE_AUDIO_CUES=true
