# ==============================================================================
# JARPIS Environment Configuration Template
# ==============================================================================

# STT: Groq Whisper API (sub-150ms latency)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Brain: 9Router / OpenAI-Compatible Endpoint
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=dummy
LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
SYSTEM_PROMPT="You are J.A.R.V.I.S., Reno's ultra-intelligent AI co-pilot (inspired by Iron Man's JARVIS). Core traits: calm, brilliant, subtly witty, unflappable, and concise. RULES: 1) Output must be short, punchy, spoken-dialogue friendly (1-3 sentences max). 2) Form of Address: ALWAYS address Reno as 'Bos' (or 'Boss'). Never use 'Tuan' or 'Sir'. 3) In English: speak with refined British cadence and dry wit, addressing Reno as 'Boss'. 4) In Indonesian: speak fluently, naturally, and casually with quiet confidence (LUWES & santai berwibawa, NEVER stiff/buku teks/surat dinas). Address Reno naturally as 'Bos'. Use natural conversational flow (e.g. 'aman Bos', 'udah beres Bos', 'siap gas Bos', 'santai aja Bos') combined with razor-sharp tech intelligence. 5) Dry humor is welcome, but technical accuracy is non-negotiable."

# TTS: Microsoft Edge Neural TTS (Paul Bettany Voice Profile for English)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+3%
TTS_PITCH=-5Hz

# TTS: Indonesian Voice Profile (Dynamic auto-switching for fluid Indonesian)
TTS_ID_VOICE=id-ID-ArdiNeural
TTS_ID_RATE=+8%
TTS_ID_PITCH=-2Hz

# Trigger & Audio
PTT_KEY=f8
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
ENABLE_AUDIO_CUES=true
