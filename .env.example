# ==============================================================================
# JARPIS Environment Configuration Template
# ==============================================================================

# STT: Groq Whisper API (sub-150ms latency)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3-turbo

# Brain: 9Router / OpenAI-Compatible Endpoint
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=dummy
LLM_MODEL=anthropic/claude-3-5-sonnet-20241022
SYSTEM_PROMPT="Kamu adalah Jarvis, asisten AI pribadi. Jawab singkat, padat, teknis, dan natural dalam bahasa Indonesia."

# TTS: Microsoft Edge Neural TTS
TTS_VOICE=id-ID-ArdiNeural
# Alternatif: en-US-ChristopherNeural, id-ID-GadisNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Trigger & Audio
PTT_KEY=f8
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
ENABLE_AUDIO_CUES=true
